    "bluebird": "^3.7.2",
    "canvas-text-wrapper": "^0.10.2",
    "cheerio": "^1.0.0-rc.2",
    "chrono-node": "github:PolestarLabs/chrono",
    "colors": "^1.4.0",
    "cron": "^1.5.1",
    "date-fns": "^2.22.1",
    "eris": "github:PolestarLabs/eris#dev",
