    "@types/i18next": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^4.9.1",
    "@typescript-eslint/parser": "^4.10.0",
    "eslint": "^7.2.0",
    "eslint-config-airbnb-base": "^14.2.0",
